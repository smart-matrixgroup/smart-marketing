# Copy to ".env" (project root for dev, or %APPDATA%\SMART Social Manager\.env for the installed app)
PORT=4010
# true = clearly labelled DEMO mode (nothing is really posted). Set false for real publishing.
DEMO_MODE=true
# First-run company login (change immediately; stored hashed in SQLite)
SMART_ADMIN_USER=admin
SMART_ADMIN_PASSWORD=ChangeMe@123
# Google OAuth (Gmail sending) - Google Cloud Console > OAuth client (Web). Redirect URI: http://127.0.0.1:4010/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
